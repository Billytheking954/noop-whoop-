    "%lld/100": {"shouldTranslate": false},
    "Training readiness estimate · %lld/100": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Training readiness estimate · %lld/100"}}, "de": {"stringUnit": {"state": "translated", "value": "Geschätzte Trainingsbereitschaft · %lld/100"}}, "es": {"stringUnit": {"state": "translated", "value": "Preparación estimada para entrenar · %lld/100"}}, "fr": {"stringUnit": {"state": "translated", "value": "Préparation estimée à l’entraînement · %lld/100"}}, "it": {"stringUnit": {"state": "translated", "value": "Prontezza stimata all’allenamento · %lld/100"}}, "pl": {"stringUnit": {"state": "translated", "value": "Szacowana gotowość do treningu · %lld/100"}}, "pt-PT": {"stringUnit": {"state": "translated", "value": "Prontidão estimada para treinar · %lld/100"}}, "ru": {"stringUnit": {"state": "translated", "value": "Оценка готовности к тренировке · %lld/100"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "训练准备度估算 · %lld/100"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "訓練準備度估算 · %lld/100"}}}},
    "%lld%% signal coverage": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "%lld%% signal coverage"}}, "de": {"stringUnit": {"state": "translated", "value": "%lld %% Signalabdeckung"}}, "es": {"stringUnit": {"state": "translated", "value": "%lld %% de cobertura de señales"}}, "fr": {"stringUnit": {"state": "translated", "value": "Couverture des signaux : %lld %%"}}, "it": {"stringUnit": {"state": "translated", "value": "Copertura dei segnali: %lld%%"}}, "pl": {"stringUnit": {"state": "translated", "value": "Pokrycie sygnałów: %lld%%"}}, "pt-PT": {"stringUnit": {"state": "translated", "value": "Cobertura dos sinais: %lld%%"}}, "ru": {"stringUnit": {"state": "translated", "value": "Охват сигналов: %lld%%"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "信号覆盖率 %lld%%"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "訊號覆蓋率 %lld%%"}}}},
    "Energy Reserve estimate · %lld/100": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Energy Reserve estimate · %lld/100"}}, "de": {"stringUnit": {"state": "translated", "value": "Geschätzte Energiereserve · %lld/100"}}, "es": {"stringUnit": {"state": "translated", "value": "Reserva de energía estimada · %lld/100"}}, "fr": {"stringUnit": {"state": "translated", "value": "Réserve d’énergie estimée · %lld/100"}}, "it": {"stringUnit": {"state": "translated", "value": "Riserva di energia stimata · %lld/100"}}, "pl": {"stringUnit": {"state": "translated", "value": "Szacowany zapas energii · %lld/100"}}, "pt-PT": {"stringUnit": {"state": "translated", "value": "Reserva de energia estimada · %lld/100"}}, "ru": {"stringUnit": {"state": "translated", "value": "Оценка запаса энергии · %lld/100"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "能量储备估算 · %lld/100"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "能量儲備估算 · %lld/100"}}}},
    "Experimental daily estimate · %lld%% signal coverage": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Experimental daily estimate · %lld%% signal coverage"}}, "de": {"stringUnit": {"state": "translated", "value": "Experimentelle Tagesschätzung · %lld %% Signalabdeckung"}}, "es": {"stringUnit": {"state": "translated", "value": "Estimación diaria experimental · %lld %% de cobertura de señales"}}, "fr": {"stringUnit": {"state": "translated", "value": "Estimation quotidienne expérimentale · couverture des signaux : %lld %%"}}, "it": {"stringUnit": {"state": "translated", "value": "Stima giornaliera sperimentale · copertura dei segnali: %lld%%"}}, "pl": {"stringUnit": {"state": "translated", "value": "Eksperymentalna ocena dzienna · pokrycie sygnałów: %lld%%"}}, "pt-PT": {"stringUnit": {"state": "translated", "value": "Estimativa diária experimental · cobertura dos sinais: %lld%%"}}, "ru": {"stringUnit": {"state": "translated", "value": "Экспериментальная оценка за день · охват сигналов: %lld%%"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "实验性每日估算 · 信号覆盖率 %lld%%"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "實驗性每日估算 · 訊號覆蓋率 %lld%%"}}}},
    "Estimated training readiness, %lld out of 100": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Estimated training readiness, %lld out of 100"}}, "de": {"stringUnit": {"state": "translated", "value": "Geschätzte Trainingsbereitschaft, %lld von 100"}}, "es": {"stringUnit": {"state": "translated", "value": "Preparación estimada para entrenar, %lld de 100"}}, "fr": {"stringUnit": {"state": "translated", "value": "Préparation estimée à l’entraînement, %lld sur 100"}}, "it": {"stringUnit": {"state": "translated", "value": "Prontezza stimata all’allenamento, %lld su 100"}}, "pl": {"stringUnit": {"state": "translated", "value": "Szacowana gotowość do treningu: %lld na 100"}}, "pt-PT": {"stringUnit": {"state": "translated", "value": "Prontidão estimada para treinar, %lld em 100"}}, "ru": {"stringUnit": {"state": "translated", "value": "Оценка готовности к тренировке: %lld из 100"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "训练准备度估算，满分 100 得 %lld 分"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "訓練準備度估算，滿分 100 得 %lld 分"}}}},
    "Estimate from %lld%% available signal coverage; not a medical measurement.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Estimate from %lld%% available signal coverage; not a medical measurement."}}, "de": {"stringUnit": {"state": "translated", "value": "Schätzung auf Basis von %lld %% der vorgesehenen Signale. Kein medizinischer Messwert."}}, "es": {"stringUnit": {"state": "translated", "value": "Estimación basada en el %lld %% de las señales previstas. No es una medición médica."}}, "fr": {"stringUnit": {"state": "translated", "value": "Estimation fondée sur %lld %% des signaux attendus. Il ne s’agit pas d’une mesure médicale."}}, "it": {"stringUnit": {"state": "translated", "value": "Stima basata sul %lld%% dei segnali previsti. Non è una misurazione medica."}}, "pl": {"stringUnit": {"state": "translated", "value": "Szacunek na podstawie %lld%% przewidzianych sygnałów. Nie jest to pomiar medyczny."}}, "pt-PT": {"stringUnit": {"state": "translated", "value": "Estimativa baseada em %lld%% dos sinais previstos. Não é uma medição médica."}}, "ru": {"stringUnit": {"state": "translated", "value": "Оценка по %lld%% предусмотренных сигналов. Это не медицинское измерение."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "根据 %lld%% 的预期信号估算，不属于医学测量。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "根據 %lld%% 的預期訊號估算，不屬於醫學測量。"}}}},
    "Sleep duration": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Sleep duration"}}, "de": {"stringUnit": {"state": "translated", "value": "Schlafdauer"}}, "es": {"stringUnit": {"state": "translated", "value": "Duración del sueño"}}, "fr": {"stringUnit": {"state": "translated", "value": "Durée du sommeil"}}, "it": {"stringUnit": {"state": "translated", "value": "Durata del sonno"}}, "pl": {"stringUnit": {"state": "translated", "value": "Czas snu"}}, "pt-PT": {"stringUnit": {"state": "translated", "value": "Duração do sono"}}, "ru": {"stringUnit": {"state": "translated", "value": "Продолжительность сна"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "睡眠时长"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "睡眠時長"}}}},
    "Sleep consistency": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Sleep consistency"}}, "de": {"stringUnit": {"state": "translated", "value": "Regelmäßigkeit der Schlafdauer"}}, "es": {"stringUnit": {"state": "translated", "value": "Regularidad de la duración del sueño"}}, "fr": {"stringUnit": {"state": "translated", "value": "Régularité de la durée du sommeil"}}, "it": {"stringUnit": {"state": "translated", "value": "Regolarità della durata del sonno"}}, "pl": {"stringUnit": {"state": "translated", "value": "Regularność długości snu"}}, "pt-PT": {"stringUnit": {"state": "translated", "value": "Regularidade da duração do sono"}}, "ru": {"stringUnit": {"state": "translated", "value": "Стабильность продолжительности сна"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "睡眠时长规律性"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "睡眠時長規律性"}}}},
    "within a reference band (acute:chronic %@)": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "within a reference band (acute:chronic %@)"}}, "de": {"stringUnit": {"state": "translated", "value": "im Richtbereich (akut:chronisch %@)"}}, "es": {"stringUnit": {"state": "translated", "value": "dentro del intervalo de referencia (aguda:crónica %@)"}}, "fr": {"stringUnit": {"state": "translated", "value": "dans la plage de référence (aiguë:chronique %@)"}}, "it": {"stringUnit": {"state": "translated", "value": "nell’intervallo di riferimento (acuto:cronico %@)"}}, "pl": {"stringUnit": {"state": "translated", "value": "w zakresie referencyjnym (krótkoterminowe:długoterminowe %@)"}}, "pt-PT": {"stringUnit": {"state": "translated", "value": "no intervalo de referência (aguda:crónica %@)"}}, "ru": {"stringUnit": {"state": "translated", "value": "в референсном диапазоне (краткосрочная:долгосрочная %@)"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "处于参考范围内（急性:慢性 %@）"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "處於參考範圍內（急性:慢性 %@）"}}}},
    "spiking (acute:chronic %@) - recent load is elevated; monitor fatigue": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "spiking (acute:chronic %@) - recent load is elevated; monitor fatigue"}}, "de": {"stringUnit": {"state": "translated", "value": "starker Anstieg (akut:chronisch %@) – hohe Belastung in letzter Zeit; auf Ermüdung achten"}}, "es": {"stringUnit": {"state": "translated", "value": "aumento brusco (aguda:crónica %@): la carga reciente es alta; vigila la fatiga"}}, "fr": {"stringUnit": {"state": "translated", "value": "forte hausse (aiguë:chronique %@) : charge récente élevée, surveillez la fatigue"}}, "it": {"stringUnit": {"state": "translated", "value": "forte aumento (acuto:cronico %@): carico recente elevato, monitora la fatica"}}, "pl": {"stringUnit": {"state": "translated", "value": "gwałtowny wzrost (krótkoterminowe:długoterminowe %@): ostatnie obciążenie jest wysokie, obserwuj zmęczenie"}}, "pt-PT": {"stringUnit": {"state": "translated", "value": "aumento acentuado (aguda:crónica %@): carga recente elevada, monitorize a fadiga"}}, "ru": {"stringUnit": {"state": "translated", "value": "резкий рост (краткосрочная:долгосрочная %@): недавняя нагрузка повышена, следите за утомлением"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "负荷骤增（急性:慢性 %@）：近期负荷较高，请留意疲劳"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "負荷驟增（急性:慢性 %@）：近期負荷較高，請留意疲勞"}}}},
    "Energy Reserve": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Energy Reserve"}}, "de": {"stringUnit": {"state": "translated", "value": "Energiereserve"}}, "es": {"stringUnit": {"state": "translated", "value": "Reserva de energía"}}, "fr": {"stringUnit": {"state": "translated", "value": "Réserve d’énergie"}}, "it": {"stringUnit": {"state": "translated", "value": "Riserva di energia"}}, "pl": {"stringUnit": {"state": "translated", "value": "Zapas energii"}}, "pt-PT": {"stringUnit": {"state": "translated", "value": "Reserva de energia"}}, "ru": {"stringUnit": {"state": "translated", "value": "Запас энергии"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "能量储备"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "能量儲備"}}}},
    "Experimental daily estimate": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Experimental daily estimate"}}, "de": {"stringUnit": {"state": "translated", "value": "Experimentelle Tagesschätzung"}}, "es": {"stringUnit": {"state": "translated", "value": "Estimación diaria experimental"}}, "fr": {"stringUnit": {"state": "translated", "value": "Estimation quotidienne expérimentale"}}, "it": {"stringUnit": {"state": "translated", "value": "Stima giornaliera sperimentale"}}, "pl": {"stringUnit": {"state": "translated", "value": "Eksperymentalna ocena dzienna"}}, "pt-PT": {"stringUnit": {"state": "translated", "value": "Estimativa diária experimental"}}, "ru": {"stringUnit": {"state": "translated", "value": "Экспериментальная оценка за день"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "实验性每日估算"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "實驗性每日估算"}}}},
    "Approximation using %lld%% of available weighted inputs; separate from Charge and Readiness.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Approximation using %lld%% of available weighted inputs; separate from Charge and Readiness."}}, "de": {"stringUnit": {"state": "translated", "value": "Schätzung anhand von %lld %% der verfügbaren gewichteten Eingaben, unabhängig von Charge und Trainingsbereitschaft."}}, "es": {"stringUnit": {"state": "translated", "value": "Aproximación basada en el %lld %% de los datos ponderados disponibles, independiente de la Carga y la Preparación."}}, "fr": {"stringUnit": {"state": "translated", "value": "Approximation fondée sur %lld %% des données pondérées disponibles, indépendante de la Charge et de la Préparation."}}, "it": {"stringUnit": {"state": "translated", "value": "Approssimazione basata sul %lld%% dei dati ponderati disponibili, distinta da Carica e Prontezza."}}, "pl": {"stringUnit": {"state": "translated", "value": "Szacunek na podstawie %lld%% dostępnych ważonych danych, niezależny od poziomu Naładowania i Gotowości."}}, "pt-PT": {"stringUnit": {"state": "translated", "value": "Aproximação baseada em %lld%% dos dados ponderados disponíveis, independente da Carga e da Prontidão."}}, "ru": {"stringUnit": {"state": "translated", "value": "Оценка по %lld%% доступных взвешенных данных, отдельно от показателей заряда и готовности."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "估算基于 %lld%% 的可用加权数据，独立于充能和准备度。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "估算基於 %lld%% 的可用加權資料，獨立於充能和準備度。"}}}},
    "This is not a measured battery level or medical assessment. No workout timestamps or minute-by-minute values have been inferred.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "This is not a measured battery level or medical assessment. No workout timestamps or minute-by-minute values have been inferred."}}, "de": {"stringUnit": {"state": "translated", "value": "Dies ist weder ein gemessener Akkustand noch eine medizinische Beurteilung. Es wurden weder Trainingszeitpunkte noch Minutenwerte rekonstruiert."}}, "es": {"stringUnit": {"state": "translated", "value": "No es un nivel de batería medido ni una evaluación médica. No se han deducido horas de entrenamiento ni valores minuto a minuto."}}, "fr": {"stringUnit": {"state": "translated", "value": "Il ne s’agit ni d’un niveau de batterie mesuré ni d’une évaluation médicale. Aucun horaire d’entraînement ni aucune valeur minute par minute n’a été déduit."}}, "it": {"stringUnit": {"state": "translated", "value": "Non è un livello di batteria misurato né una valutazione medica. Non sono stati dedotti orari degli allenamenti o valori minuto per minuto."}}, "pl": {"stringUnit": {"state": "translated", "value": "To nie jest pomiar poziomu baterii ani ocena medyczna. Nie oszacowano znaczników czasu treningów ani wartości dla poszczególnych minut."}}, "pt-PT": {"stringUnit": {"state": "translated", "value": "Não é um nível de bateria medido nem uma avaliação médica. Não foram inferidas horas de treino nem valores minuto a minuto."}}, "ru": {"stringUnit": {"state": "translated", "value": "Это не измеренный уровень заряда батареи и не медицинская оценка. Время тренировок и поминутные значения не вычислялись."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "这不是实测电量或医学评估。未推算训练时间戳或逐分钟数值。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "這並非實測電量或醫學評估。未推算訓練時間戳記或逐分鐘數值。"}}}},
    "Not enough recorded sleep and recovery context for an Energy Reserve estimate.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Not enough recorded sleep and recovery context for an Energy Reserve estimate."}}, "de": {"stringUnit": {"state": "translated", "value": "Nicht genügend aufgezeichnete Schlaf- und Erholungsdaten für eine Schätzung der Energiereserve."}}, "es": {"stringUnit": {"state": "translated", "value": "Faltan datos registrados de sueño y recuperación para estimar la reserva de energía."}}, "fr": {"stringUnit": {"state": "translated", "value": "Les données de sommeil et de récupération enregistrées ne suffisent pas pour estimer la réserve d’énergie."}}, "it": {"stringUnit": {"state": "translated", "value": "I dati registrati su sonno e recupero non bastano per stimare la riserva di energia."}}, "pl": {"stringUnit": {"state": "translated", "value": "Za mało zapisanych danych o śnie i regeneracji, aby oszacować zapas energii."}}, "pt-PT": {"stringUnit": {"state": "translated", "value": "Os dados registados de sono e recuperação são insuficientes para estimar a reserva de energia."}}, "ru": {"stringUnit": {"state": "translated", "value": "Недостаточно записанных данных о сне и восстановлении для оценки запаса энергии."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "记录的睡眠和恢复数据不足，无法估算能量储备。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "記錄的睡眠和恢復資料不足，無法估算能量儲備。"}}}}
  },
  "version": "1.0"
}
