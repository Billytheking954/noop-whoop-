            "value": "Min. geschlafen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "min dormidos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "min de sommeil"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "min a dormir"
          }
        }
      }
    },
    "Sleep stages are estimates. Original sleep records and editing stay in the V2 dashboard.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep stages are estimates. Original sleep records and editing stay in the V2 dashboard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlafphasen sind Schätzungen. Die ursprünglichen Schlafdaten und die Bearbeitung bleiben im V2-Dashboard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fases del sueño son estimaciones. Los registros originales y su edición siguen en el panel V2."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les phases de sommeil sont estimées. Les données d'origine et leur modification restent dans le tableau de bord V2."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As fases do sono são estimativas. Os registos originais e a edição continuam no painel V2."
          }
        }
      }
    },
    "Calculated by V2 from recorded activity. No missing samples are filled in.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculated by V2 from recorded activity. No missing samples are filled in."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von V2 anhand aufgezeichneter Aktivität berechnet. Fehlende Messwerte werden nicht ergänzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado por V2 a partir de la actividad registrada. No se rellenan muestras ausentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculé par V2 à partir de l'activité enregistrée. Aucune mesure manquante n'est inventée."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado pelo V2 a partir da atividade registada. Não são preenchidas amostras em falta."
          }
        }
      }
    },
    "Aura uses V2's day-level summary. Sensor sample times and per-field provenance are not exposed by this summary, so neither is invented here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura uses V2's day-level summary. Sensor sample times and per-field provenance are not exposed by this summary, so neither is invented here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura nutzt die Tagesübersicht von V2. Messzeitpunkte und einzelne Datenquellen sind darin nicht enthalten und werden hier nicht erfunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura utiliza el resumen diario de V2. No incluye horas de muestras ni procedencias por campo, así que no se inventan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aura utilise le résumé quotidien de V2. Il ne contient ni les heures des mesures ni leur provenance par champ, qui ne sont donc pas inventées."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Aura usa o resumo diário do V2. Não contém horas das amostras nem origens por campo, pelo que não são inventadas."
          }
        }
      }
    },
