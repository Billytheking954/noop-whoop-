    "NOOP Charge estimate from the recorded day, not a live energy level.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NOOP Charge estimate from the recorded day, not a live energy level."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NOOP-Charge-Schätzwert für den aufgezeichneten Tag, kein aktueller Energiewert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimación de NOOP Charge para el día registrado, no un nivel de energía en directo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimation NOOP Charge pour la journée enregistrée, pas un niveau d'énergie en direct."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimativa do NOOP Charge para o dia registado, não um nível de energia em tempo real."
          }
        }
      }
    },
    "min asleep": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "min asleep"
          }
        },
        "de": {
          "stringUnit": {
