    "Your workout is kept on this device. Retry saving it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your workout is kept on this device. Retry saving it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Training bleibt auf diesem Gerät gespeichert. Versuche die Speicherung erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu entrenamiento se conserva en este dispositivo. Intenta guardarlo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre séance est conservée sur cet appareil. Réessayez de l’enregistrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo allenamento è conservato su questo dispositivo. Riprova a salvarlo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trening jest zachowany na tym urządzeniu. Ponów zapis."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O treino está guardado neste dispositivo. Tenta guardá-lo novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренировка сохранена на этом устройстве. Повторите попытку записи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "训练保留在此设备上。请重试保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訓練保留在此裝置上。請重試儲存。"
          }
        }
      }
    },
    "History could not be refreshed. Retry to load your stored data.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History could not be refreshed. Retry to load your stored data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verlauf konnte nicht aktualisiert werden. Versuche erneut, deine gespeicherten Daten zu laden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo actualizar el historial. Reintenta cargar tus datos guardados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’actualiser l’historique. Réessayez de charger vos données enregistrées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aggiornare la cronologia. Riprova a caricare i dati salvati."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odświeżyć historii. Ponów wczytywanie zapisanych danych."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível atualizar o histórico. Tenta carregar os dados guardados novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось обновить историю. Повторите загрузку сохранённых данных."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法刷新历史记录。请重试加载已保存的数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法更新歷史記錄。請重試載入已儲存的資料。"
          }
        }
      }
    },
    "History could not be opened.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History could not be opened."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verlauf konnte nicht geöffnet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir el historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir l’historique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire la cronologia."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się otworzyć historii."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir o histórico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть историю."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开历史记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法開啟歷史記錄。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
