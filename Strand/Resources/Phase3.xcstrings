{
  "sourceLanguage": "en",
  "strings": {
    "Adds a one-time, redacted snapshot of the real inputs and experimental estimates to this Recovery report. Missing data stays missing; no health history is changed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt diesem Erholungsbericht einmalig einen redigierten Schnappschuss der echten Eingaben und experimentellen Schätzwerte hinzu. Fehlende Daten bleiben fehlend; der Gesundheitsverlauf wird nicht verändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds a one-time, redacted snapshot of the real inputs and experimental estimates to this Recovery report. Missing data stays missing; no health history is changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade a este informe de recuperación una instantánea puntual y redactada de los datos reales y las estimaciones experimentales. Los datos ausentes siguen ausentes; no se modifica el historial de salud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute à ce rapport de récupération un instantané ponctuel et expurgé des données réelles et des estimations expérimentales. Les données manquantes le restent ; aucun historique de santé n’est modifié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge a questo rapporto di recupero un'istantanea singola e oscurata degli input reali e delle stime sperimentali. I dati mancanti restano tali; la cronologia sanitaria non viene modificata."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaje do raportu regeneracji jednorazowy, zredagowany zapis rzeczywistych danych wejściowych i eksperymentalnych szacunków. Brakujące dane pozostają brakujące; historia zdrowia nie jest zmieniana."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona a este relatório de recuperação um instantâneo único e editado dos dados reais e das estimativas experimentais. Os dados em falta continuam em falta; o histórico de saúde não é alterado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет в отчёт о восстановлении разовый отредактированный снимок реальных входных данных и экспериментальных оценок. Отсутствующие данные не подменяются; история здоровья не изменяется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向此恢复报告添加一次经过编辑的真实输入和实验性估算快照。缺失数据仍保持缺失；健康历史不会更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向此恢復報告加入一次經過編輯的真實輸入和實驗性估算快照。缺失資料仍保持缺失；健康記錄不會更改。"
          }
        }
      }
    },
    "Capture Energy & Readiness evidence": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachweise für Energie und Trainingsbereitschaft erfassen"
