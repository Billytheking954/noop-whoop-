    "Evidence captured. Tap Share to review and export.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachweise erfasst. Tippe zum Prüfen und Exportieren auf „Teilen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Evidence captured. Tap Share to review and export."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pruebas capturadas. Pulsa Compartir para revisarlas y exportarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preuves capturées. Touchez Partager pour les vérifier et les exporter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prove acquisite. Tocca Condividi per controllarle ed esportarle."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane zarejestrowane. Stuknij Udostępnij, aby je sprawdzić i wyeksportować."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Evidências capturadas. Toque em Partilhar para rever e exportar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные собраны. Нажмите «Поделиться», чтобы проверить и экспортировать их."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "证据已采集。轻点“共享”以查看并导出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "證據已擷取。點一下「分享」以檢視並匯出。"
          }
        }
      }
    },
