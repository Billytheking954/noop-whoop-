{
  "sourceLanguage": "en",
  "strings": {
    "Workout export unavailable": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Workout export unavailable"}}, "de": {"stringUnit": {"state": "translated", "value": "Trainingsexport nicht verfügbar"}}, "es": {"stringUnit": {"state": "translated", "value": "Exportación del entrenamiento no disponible"}}, "fr": {"stringUnit": {"state": "translated", "value": "Exportation de la séance indisponible"}}, "it": {"stringUnit": {"state": "translated", "value": "Esportazione dell’allenamento non disponibile"}}, "pl": {"stringUnit": {"state": "translated", "value": "Eksport treningu niedostępny"}}, "pt-PT": {"stringUnit": {"state": "translated", "value": "Exportação do treino indisponível"}}, "ru": {"stringUnit": {"state": "translated", "value": "Экспорт тренировки недоступен"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法导出训练"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法匯出訓練"}}}},
    "Workout export": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Workout export"}}, "de": {"stringUnit": {"state": "translated", "value": "Trainingsexport"}}, "es": {"stringUnit": {"state": "translated", "value": "Exportación del entrenamiento"}}, "fr": {"stringUnit": {"state": "translated", "value": "Exportation de la séance"}}, "it": {"stringUnit": {"state": "translated", "value": "Esportazione dell’allenamento"}}, "pl": {"stringUnit": {"state": "translated", "value": "Eksport treningu"}}, "pt-PT": {"stringUnit": {"state": "translated", "value": "Exportação do treino"}}, "ru": {"stringUnit": {"state": "translated", "value": "Экспорт тренировки"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "导出训练"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "匯出訓練"}}}},
    "Recorded data only": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Recorded data only"}}, "de": {"stringUnit": {"state": "translated", "value": "Nur aufgezeichnete Daten"}}, "es": {"stringUnit": {"state": "translated", "value": "Solo datos registrados"}}, "fr": {"stringUnit": {"state": "translated", "value": "Données enregistrées uniquement"}}, "it": {"stringUnit": {"state": "translated", "value": "Solo dati registrati"}}, "pl": {"stringUnit": {"state": "translated", "value": "Tylko zapisane dane"}}, "pt-PT": {"stringUnit": {"state": "translated", "value": "Apenas dados registados"}}, "ru": {"stringUnit": {"state": "translated", "value": "Только записанные данные"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "仅限已记录数据"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "僅限已記錄資料"}}}},
    "Export actual recorded HR and GPS timestamps in FIT format. Missing measurements stay missing.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Export actual recorded HR and GPS timestamps in FIT format. Missing measurements stay missing."}}, "de": {"stringUnit": {"state": "translated", "value": "Aufgezeichnete Herzfrequenzwerte und GPS-Zeitstempel als FIT exportieren. Fehlende Messwerte bleiben leer."}}, "es": {"stringUnit": {"state": "translated", "value": "Exporta los registros de frecuencia cardiaca y las marcas de tiempo GPS en formato FIT. Las mediciones que falten se dejan en blanco."}}, "fr": {"stringUnit": {"state": "translated", "value": "Exporter au format FIT les valeurs de fréquence cardiaque et les horodatages GPS enregistrés. Les mesures manquantes restent vides."}}, "it": {"stringUnit": {"state": "translated", "value": "Esporta in formato FIT i valori di frequenza cardiaca e i riferimenti temporali GPS registrati. Le misurazioni mancanti restano vuote."}}, "pl": {"stringUnit": {"state": "translated", "value": "Wyeksportuj zapisane pomiary tętna i znaczniki czasu GPS do formatu FIT. Brakujące pomiary pozostaną puste."}}, "pt-PT": {"stringUnit": {"state": "translated", "value": "Exporte os registos de frequência cardíaca e as marcas temporais de GPS em formato FIT. As medições em falta ficam em branco."}}, "ru": {"stringUnit": {"state": "translated", "value": "Экспортируйте записанные значения пульса и метки времени GPS в формате FIT. Пропущенные измерения остаются пустыми."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "以 FIT 格式导出已记录的心率和 GPS 时间戳。缺失的测量值将留空。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "以 FIT 格式匯出已記錄的心率和 GPS 時間戳記。缺少的測量值會留空。"}}}},
    "Preparing FIT…": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Preparing FIT…"}}, "de": {"stringUnit": {"state": "translated", "value": "FIT wird vorbereitet …"}}, "es": {"stringUnit": {"state": "translated", "value": "Preparando el archivo FIT…"}}, "fr": {"stringUnit": {"state": "translated", "value": "Préparation du fichier FIT…"}}, "it": {"stringUnit": {"state": "translated", "value": "Preparazione del file FIT…"}}, "pl": {"stringUnit": {"state": "translated", "value": "Przygotowywanie pliku FIT…"}}, "pt-PT": {"stringUnit": {"state": "translated", "value": "A preparar o ficheiro FIT…"}}, "ru": {"stringUnit": {"state": "translated", "value": "Подготовка файла FIT…"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "正在准备 FIT 文件…"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "正在準備 FIT 檔案…"}}}},
    "Export recorded workout (FIT)": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Export recorded workout (FIT)"}}, "de": {"stringUnit": {"state": "translated", "value": "Aufgezeichnetes Training exportieren (FIT)"}}, "es": {"stringUnit": {"state": "translated", "value": "Exportar entrenamiento registrado (FIT)"}}, "fr": {"stringUnit": {"state": "translated", "value": "Exporter la séance enregistrée (FIT)"}}, "it": {"stringUnit": {"state": "translated", "value": "Esporta l’allenamento registrato (FIT)"}}, "pl": {"stringUnit": {"state": "translated", "value": "Eksportuj zapisany trening (FIT)"}}, "pt-PT": {"stringUnit": {"state": "translated", "value": "Exportar treino registado (FIT)"}}, "ru": {"stringUnit": {"state": "translated", "value": "Экспортировать записанную тренировку (FIT)"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "导出已记录的训练（FIT）"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "匯出已記錄的訓練（FIT）"}}}},
    "Export GPX": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "Export GPX"}}, "de": {"stringUnit": {"state": "translated", "value": "GPX exportieren"}}, "es": {"stringUnit": {"state": "translated", "value": "Exportar GPX"}}, "fr": {"stringUnit": {"state": "translated", "value": "Exporter le GPX"}}, "it": {"stringUnit": {"state": "translated", "value": "Esporta GPX"}}, "pl": {"stringUnit": {"state": "translated", "value": "Eksportuj GPX"}}, "pt-PT": {"stringUnit": {"state": "translated", "value": "Exportar GPX"}}, "ru": {"stringUnit": {"state": "translated", "value": "Экспортировать GPX"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "导出 GPX"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "匯出 GPX"}}}},
    "GPX uses recorded GPS times when available. Older routes saved without timed GPS points use approximate times.": {"localizations": {"en": {"stringUnit": {"state": "translated", "value": "GPX uses recorded GPS times when available. Older routes saved without timed GPS points use approximate times."}}, "de": {"stringUnit": {"state": "translated", "value": "GPX verwendet aufgezeichnete GPS-Zeitstempel, sofern verfügbar. Ältere Routen ohne Zeitstempel verwenden ungefähre Zeiten."}}, "es": {"stringUnit": {"state": "translated", "value": "GPX utiliza las marcas de tiempo GPS registradas cuando están disponibles. Las rutas antiguas sin marcas de tiempo GPS usan horas aproximadas."}}, "fr": {"stringUnit": {"state": "translated", "value": "Le GPX utilise les horodatages GPS enregistrés lorsqu’ils sont disponibles. Pour les anciens trajets sans points GPS horodatés, les horaires sont approximatifs."}}, "it": {"stringUnit": {"state": "translated", "value": "Il GPX usa gli orari GPS registrati quando disponibili. Per i percorsi più vecchi senza orari dei punti GPS vengono usati orari approssimativi."}}, "pl": {"stringUnit": {"state": "translated", "value": "GPX wykorzystuje zapisane czasy GPS, jeśli są dostępne. Starsze trasy bez znaczników czasu GPS używają czasów przybliżonych."}}, "pt-PT": {"stringUnit": {"state": "translated", "value": "O GPX utiliza as horas GPS registadas quando disponíveis. Os percursos antigos sem pontos GPS com marcas temporais utilizam horas aproximadas."}}, "ru": {"stringUnit": {"state": "translated", "value": "GPX использует записанные метки времени GPS, если они есть. Для старых маршрутов без меток времени GPS указывается приблизительное время."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "GPX 优先使用已记录的 GPS 时间。旧路线如果没有带时间戳的 GPS 点，则使用近似时间。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "GPX 優先使用已記錄的 GPS 時間。舊路線若沒有附時間戳記的 GPS 點，則使用約略時間。"}}}}
  },
  "version": "1.0"
}
